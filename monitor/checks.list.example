# /etc/deploykit/checks.list —— 每行一个检查：<类型> <名称> <参数...>
#
# http    <名称> <URL> [期望状态码] [响应必须包含的文字]
# systemd <名称> <单元名>
# disk    <名称> <挂载点> [最大使用率%]
# tcp     <名称> <主机> <端口>
# cmd     <名称> <任意 shell 命令，退出码 0 即正常>

http    api-health  http://127.0.0.1:3000/api/health 200 ok
systemd app         myapp.service
disk    root        /  90
# tcp   redis       127.0.0.1 6379
# cmd   db-size     test $(stat -c %s /opt/app/database.sqlite) -gt 0
